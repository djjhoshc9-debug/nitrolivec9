
---
// Importamos el enrutador de transiciones de Astro
import { ClientRouter } from 'astro:transitions';
import PLayeronline from '@/components/PLayeronline.astro';

---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Nitro Live C9</title>
		
		<!-- 1. Esto activa la magia para que las páginas no se recarguen por completo -->
		<ClientRouter />
	</head>
	<body>
		<!-- El slot se encargará de cambiar el contenido de tus páginas de noticias -->
		<slot />

		<!-- 2. Tu reproductor fijo. La directiva 'transition:persist' evita que se reinicie -->
		<PLayeronline transition:persist />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* Un estilo básico para fijar el reproductor en la parte inferior de la pantalla */
	#global-player {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100%;
		background: #111;
		padding: 10px;
		display: flex;
		justify-content: center;
		z-index: 999;
	}
</style>