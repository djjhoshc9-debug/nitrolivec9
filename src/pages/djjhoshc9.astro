  <!-- automático AUDIO-->
  

<script>
document.addEventListener('DOMContentLoaded', () => {

  const players = document.querySelectorAll('.custom-audio-player');

  players.forEach((player) => {

    const audio = player.querySelector('audio');
    const playBtn = player.querySelector('.play-btn');
    const progress = player.querySelector('.progress-bar');
    const currentTime = player.querySelector('.current-time');
    const duration = player.querySelector('.duration');

    const status = player.parentElement.querySelector('.audio-status');

    // Formato de tiempo
    const formatTime = (seconds) => {
      if (!Number.isFinite(seconds)) return '0:00';

      const min = Math.floor(seconds / 60);
      const sec = Math.floor(seconds % 60);

      return min + ':' + String(sec).padStart(2, '0');
    };

    // Estado del mensaje
    const updateStatus = (message, state) => {
      status.textContent = message;
      status.dataset.state = state;
      status.classList.add('is-visible');
    };

    // Botón Play / Pause
    playBtn.addEventListener('click', async () => {

      if (!audio.paused) {
        audio.pause();
        return;
      }

      try {
        await audio.play();
      } catch (error) {
        updateStatus(
          'No se pudo reproducir este mix. Inténtalo nuevamente.',
          'error'
        );
      }

    });

    // Icono según reproducción
    audio.addEventListener('play', () => {
      playBtn.textContent = '⏸';
      playBtn.setAttribute('aria-label', 'Pausar mix');

      updateStatus(
        'Espera un momento mientras se reproduce el mix...',
        'loading'
      );
    });

    // Mientras carga
    audio.addEventListener('waiting', () => {
      updateStatus(
        'Espera un momento mientras se reproduce el mix...',
        'loading'
      );
    });

    // Reproducción confirmada
    audio.addEventListener('playing', () => {
      updateStatus('Reproduciendo este mix', 'playing');
    });

    // Pausa
    audio.addEventListener('pause', () => {
      playBtn.textContent = '▶';
      playBtn.setAttribute('aria-label', 'Reproducir mix');

      status.classList.remove('is-visible');
    });

    // Datos del audio disponibles
    audio.addEventListener('loadedmetadata', () => {
      duration.textContent = formatTime(audio.duration);
    });

    // Actualizar progreso
    audio.addEventListener('timeupdate', () => {

      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        progress.value = (audio.currentTime / audio.duration) * 100;
        currentTime.textContent = formatTime(audio.currentTime);
      }

    });

    // Buscar posición en el mix
    progress.addEventListener('input', () => {

      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        audio.currentTime = (progress.value / 100) * audio.duration;
      }

    });

    // Mix finalizado
    audio.addEventListener('ended', () => {
      playBtn.textContent = '▶';
      playBtn.setAttribute('aria-label', 'Reproducir mix');
      progress.value = 0;
      currentTime.textContent = '0:00';

      updateStatus('Mix finalizado', 'ended');
    });

    // Error de reproducción
    audio.addEventListener('error', () => {
      playBtn.textContent = '▶';
      playBtn.setAttribute('aria-label', 'Reproducir mix');

      updateStatus(
        'No se pudo reproducir este mix. Inténtalo nuevamente.',
        'error'
      );
    });

  });

  // Evitar que se reproduzcan dos mixes simultáneamente
  document.addEventListener('play', (event) => {

    if (event.target.tagName !== 'AUDIO') return;

    document.querySelectorAll('.custom-audio-player audio').forEach((audio) => {
      if (audio !== event.target) {
        audio.pause();
      }
    });

  }, true);

});
</script>


