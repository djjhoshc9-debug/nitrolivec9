---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DJ Jhosh C9 — Mixes Oficiales | Nitro Live C9</title>
</head>
<body>
  <main class="wrapper">
    <header class="profile-header">
      <div class="brand">Nitro Live <span>C9</span></div>
      <h1>DJ Jhosh <span>C9</span></h1>
      <p>Escucha y descarga todos mis mixes oficiales</p>
      <!-- SECCIÓN DE REDES SOCIALES -->
<div class="social-wrapper">
  
  <!-- Redes Personales -->
  <div class="social-group">
    <span class="social-label">Redes Personales — @DjJhoshC9</span>
    <div class="social-buttons">
      <a href="https://instagram.com/djjhoshc9" target="_blank" rel="noopener noreferrer" class="social-btn ig" aria-label="Instagram Personal">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        <span>Instagram</span>
      </a>

      <a href="https://tiktok.com/@djjhoshc9" target="_blank" rel="noopener noreferrer" class="social-btn tt" aria-label="TikTok Personal">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
        <span>TikTok</span>
      </a>

      <a href="https://youtube.com/@djjhoshc9" target="_blank" rel="noopener noreferrer" class="social-btn yt" aria-label="YouTube Personal">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        <span>YouTube</span>
      </a>

      <a href="https://facebook.com/djjhoshc9" target="_blank" rel="noopener noreferrer" class="social-btn fb" aria-label="Facebook Personal">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        <span>Facebook</span>
      </a>
    </div>
  </div>

</div>

    </header>

    <section class="mix-grid">
      {mixes.map((mix) => (
        <article class="mix-card">
          <img src={mix.cover} alt={mix.title} class="mix-cover" loading="lazy" />
          <div class="mix-info">
            <h2>{mix.title}</h2>
            
            <!-- Reproductor de audio -->
            <audio controls preload="none" class="audio-player">
              <source src={mix.audioUrl} type="audio/mpeg" />
              Tu navegador no soporta el reproductor de audio.
            </audio>

            <!-- Botón conectado a tu página de descarga PHP -->
            <a href={"https://dl.nitrolivec9.com/?id=" + mix.id} target="_blank" rel="noopener noreferrer" class="btn-download">
                Descargar MP3
            </a>

          </div>
        </article>
      ))}
    </section>
    <!-- SECCIÓN DE REDES OFICIALES (ABAJO) -->
<footer class="official-footer">
  <div class="social-group">
    <span class="social-label">Redes Oficiales — Nitro Live C9</span>
    <div class="social-buttons">
      <a href="https://instagram.com/nitrolivec9" target="_blank" rel="noopener noreferrer" class="social-btn ig" aria-label="Instagram Nitro Live C9">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        <span>Instagram</span>
      </a>

      <a href="https://facebook.com/share/1FFtDLjedD/" target="_blank" rel="noopener noreferrer" class="social-btn fb" aria-label="Facebook Nitro Live C9">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        <span>Facebook</span>
      </a>

      <a href="https://wa.me/message/J7BEDY5ZTIQSC1" target="_blank" rel="noopener noreferrer" class="social-btn wa" aria-label="WhatsApp Nitro Live C9">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
  
  <a href="https://nitrolivec9.com" class="back-home">← Volver a NitroLiveC9.com</a>
</footer>

  </main>

  <!-- automático AUDIO-->
  <script>
    document.addEventListener('play', (event) => {
      const audios = document.querySelectorAll('audio');
      audios.forEach((audio) => {
        if (audio !== event.target) {
          audio.pause();
        }
      });
    }, true);
  </script>
</body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: #0b1120;
    background-image: radial-gradient(circle at top center, #172554 0%, #0b1120 65%);
    background-attachment: fixed;
    color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    padding: 30px 20px;
    min-height: 100vh;
  }

  .wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .profile-header {
    text-align: center;
    margin-bottom: 35px;
  }

  .brand {
    font-size: 1rem;
    font-weight: 700;
    color: #a0a0a0;
    margin-bottom: 8px;
  }

  .brand span, h1 span {
    color: #3498db;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .profile-header p {
    color: #a0a0a0;
    font-size: 0.95rem;
  }

  .mix-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mix-card {
    background: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .mix-cover {
    width: 110px;
    height: 110px;
    object-fit: cover;
    border-radius: 12px;
    flex-shrink: 0;
    border: 1px solid #333;
  }

  .mix-info {
    flex: 1;
    min-width: 0;
  }

  .mix-info h2 {
    font-size: 1.1rem;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .audio-player {
    width: 100%;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 8px;
  }

  .btn-download {
    display: inline-block;
    background-color: #3498db;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 20px;
    transition: background 0.2s;
  }

  .btn-download:hover {
    background-color: #2980b9;
  }
    /* Estilos de los botones sociales */
  .social-wrapper {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 25px;
    align-items: center;
  }

  .social-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .social-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #888888;
    font-weight: 600;
  }

  .social-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #2e2e2e;
    padding: 8px 16px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    transform: translateY(-2px);
    color: #ffffff;
  }
.back-home {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    margin: 35px auto 10px auto;
    color: #3498db;
    background-color: rgba(52, 152, 219, 0.08);
    border: 1px solid #3498db;
    padding: 10px 24px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

.back-home:hover {
    background-color: #3498db;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
  }



  /* Colores sutiles al pasar el cursor (hover) */
  .social-btn.ig:hover { border-color: #e1306c; background-color: rgba(225, 48, 108, 0.15); }
  .social-btn.tt:hover { border-color: #00f2fe; background-color: rgba(0, 242, 254, 0.15); }
  .social-btn.yt:hover { border-color: #ff0000; background-color: rgba(255, 0, 0, 0.15); }
  .social-btn.fb:hover { border-color: #1877f2; background-color: rgba(24, 119, 242, 0.15); }
  .social-btn.wa:hover { border-color: #25d366; background-color: rgba(37, 211, 102, 0.15); }


  @media (max-width: 600px) {
    .mix-card {
      flex-direction: column;
      text-align: center;
    }

    .mix-cover {
      width: 160px;
      height: 160px;
    }
  }
</style>
